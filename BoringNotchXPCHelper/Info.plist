<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>XPCService</key>
	<dict>
		<key>ServiceType</key>
		<string>Application</string>
		<!-- Run in the caller's security session. Otherwise the helper gets a new session in which
		     the login Keychain is locked, and reading Claude Code's login fails (errSecInteractionNotAllowed). -->
		<key>JoinExistingSession</key>
		<true/>
	</dict>
</dict>
</plist>
